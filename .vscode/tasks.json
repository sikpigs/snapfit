{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure debug",
            "type": "cmake",
            "command": "configure",
            "preset": "debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: build debug",
            "type": "cmake",
            "command": "build",
            "preset": "debug",
            "targets": [
                "snapfit"
            ],
            "dependsOn": "CMake: configure debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: run debug",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/snapfit",
            "dependsOn": "CMake: build debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: configure registry tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build registry tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug",
                "--target",
                "snapfit_tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure registry tests",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: run registry tests",
            "type": "cmake",
            "command": "test",
            "preset": "debug",
            "dependsOn": "CMake: build registry tests",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "CMake: build release",
            "type": "cmake",
            "command": "build",
            "preset": "release",
            "targets": [
                "snapfit"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
