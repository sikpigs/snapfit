{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug snapfit",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/snapfit",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build debug",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at main",
                    "text": "-break-insert main",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug registry test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/snapfit_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true,
                "moduleLoad": false,
                "programOutput": true
            },
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod network lookups",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
