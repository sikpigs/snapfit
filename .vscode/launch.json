{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug snapfit",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/snapfit",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build debug",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at main",
                    "text": "-break-insert main",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
