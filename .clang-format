---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

# Layout
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
ContinuationIndentWidth: 4
NamespaceIndentation: All
AccessModifierOffset: -4

# Keep Allman-style braces except for structs. Clang-format does not have a
# separate "attach only empty records" option, so struct opening braces attach.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: false
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  SplitEmptyNamespace: true
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
InsertBraces: true

# Expressions and declarations
PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: false
AlignAfterOpenBracket: Align
AlignOperands: Align
BreakBeforeBinaryOperators: NonAssignment
BinPackArguments: false
BinPackParameters: false

# Put each constructor initializer on one line, with leading punctuation.
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 4

# Includes
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Preserve useful structure while keeping definitions easy to scan.
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Leave
FixNamespaceComments: true

# Modern C++ constructs
AlwaysBreakTemplateDeclarations: Yes
SpaceAfterTemplateKeyword: false
SpaceBeforeParens: ControlStatements
SpaceBeforeCpp11BracedList: true
Cpp11BracedListStyle: false
SpacesInAngles: Never
SpaceInEmptyBlock: true
IndentRequiresClause: true
RequiresClausePosition: OwnLine
...
